# ============================================================
# Environment Variables Template
# Copy this file to .env: copy .env.example .env
# ============================================================

# Local Vector Storage Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chromadb
CHROMA_COLLECTION_NAME=asterline_kb
CORPUS_FILE_PATH=./corpus.jsonl

# LangSmith Observability Configuration (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=asterline-research-assistant

# OpenAI API Key (Optional - Fallback to deterministic synthesizer if omitted)
# OPENAI_API_KEY=your-openai-api-key-here
